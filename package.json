  "main": "index.js",
  "scripts": {
    "start": "npx serve . -p 8080",
    "serve": "npx serve . -p 8080",
    "crawl": "node index.js",
    "crawl:help": "node index.js --help"
  },
  "keywords": [
    "echarts",
    "echarts-gl",
    "mapbox",
    "mapbox-gl",
    "3d-map",
    "geojson",
    "data-visualization",
    "amap",
    "webgl",
    "smart-city",
    "urban-computing"
  ],
  "author": "hopkinson <1651690426@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hopkinson/mapandbuilding.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
